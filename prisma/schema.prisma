generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Analysis {
  id        String   @id @default(cuid())
  league    String
  matchDate String
  homeTeam  String
  awayTeam  String
  result    String
  odds      String?
  createdAt DateTime @default(now())
}
