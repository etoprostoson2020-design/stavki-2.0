# Скопировать в .env. Файл .env в git не попадает.
FSL_ENV=dev
FSL_LOG_LEVEL=INFO

FSL_POSTGRES_DSN=postgresql+psycopg://fsl:fsl_dev@127.0.0.1:5432/fsl
FSL_REDIS_URL=redis://127.0.0.1:6379/0

FSL_STORAGE_ROOT=./storage

# Football-Data.co.uk — публичный источник, ключ не нужен.
FSL_FOOTBALLDATA_BASE_URL=https://www.football-data.co.uk/mmz4281

# API-Football — подключается в фазе 6, не в MVP.
# Ключ ТОЛЬКО здесь. Никогда в репозитории, в Registry и в логах.
FSL_APIFOOTBALL_KEY=
